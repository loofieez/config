# ~/.config/git/config
# global gitconfig

# core
[core]
  # set neovim as editor
  editor = nvim
  # preserve exec file-perm
  fileMode = true

# init
[init]
  # set default branch to main
  defaultBranch = main

# for remote projects
[includeif "gitdir:~/src/remote/"]
  path = ~/src/remote/.gitconfig

# for local projects
[includeif "gitdir:~/src/local/"]
  path = ~/src/local/.gitconfig
